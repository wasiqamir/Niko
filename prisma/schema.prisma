generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  HOST
  PARTICIPANT
}

enum MeetingStatus {
  SCHEDULED
  DECLINED
}

enum MeetingLinkStatus {
  SCHEDULED
  CANCELLED
}

enum TeamStatus {
  PENDING
  ACTIVE
}

enum TeamMemberStatus {
  PENDING
  ACTIVE
}

enum TeamMeetingStatus {
  SCHEDULED
  CANCELLED
}

model User {
  id                 String              @id @default(cuid())
  name               String
  email              String              @unique
  passwordHash       String
  accountType        AccountType
  emailVerifiedAt      DateTime?
  hoursReady           Boolean             @default(false)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  sessions             Session[]
  verificationTokens   VerificationToken[]
  passwordResetTokens  PasswordResetToken[]
  devMails             DevMail[]
  availability         Availability[]
  hostedMeetings       Meeting[]           @relation("HostMeetings")
  participantMeetings  Meeting[]           @relation("ParticipantMeetings")
  meetingLinks         MeetingLink[]
  meetingLinkGuests    MeetingLinkGuest[]
  ownedTeam            Team?               @relation("OwnedTeams")
  teamMemberships      TeamMember[]
}

model Availability {
  id        String @id @default(cuid())
  hostId    String
  host      User   @relation(fields: [hostId], references: [id], onDelete: Cascade)
  weekday   Int
  startHour Int
  endHour   Int

  @@index([hostId, weekday])
}

model MeetingLink {
  id        String            @id @default(cuid())
  hostId    String
  host      User              @relation(fields: [hostId], references: [id], onDelete: Cascade)
  code      String            @unique
  title     String
  participantName String?
  startAt   DateTime
  endAt     DateTime
  capacity  Int
  status         MeetingLinkStatus @default(SCHEDULED)
  reminderSentAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  guests    MeetingLinkGuest[]

  @@index([hostId, startAt])
}

model MeetingLinkGuest {
  id            String      @id @default(cuid())
  meetingLinkId String
  meetingLink   MeetingLink @relation(fields: [meetingLinkId], references: [id], onDelete: Cascade)
  participantId String
  participant   User        @relation(fields: [participantId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([meetingLinkId, participantId])
  @@index([participantId])
}

model CallPresence {
  id       String   @id @default(cuid())
  roomCode String
  peerId   String
  userId   String
  name     String
  lastSeen DateTime

  @@unique([roomCode, peerId])
  @@index([roomCode, lastSeen])
}

model CallSignal {
  id        Int      @id @default(autoincrement())
  roomCode  String
  fromId    String
  toId      String
  kind      String
  payload   String
  createdAt DateTime @default(now())

  @@index([roomCode, id])
}

model Meeting {
  id               String        @id @default(cuid())
  hostId           String
  host             User          @relation("HostMeetings", fields: [hostId], references: [id], onDelete: Cascade)
  participantId    String
  participant      User          @relation("ParticipantMeetings", fields: [participantId], references: [id], onDelete: Cascade)
  startAt          DateTime
  endAt            DateTime
  status           MeetingStatus @default(SCHEDULED)
  reminderSentAt   DateTime?
  declineTokenHash String?       @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([hostId, startAt])
  @@index([participantId, startAt])
}

model Team {
  id        String     @id @default(cuid())
  name      String
  ownerId   String     @unique
  owner     User       @relation("OwnedTeams", fields: [ownerId], references: [id], onDelete: Cascade)
  status    TeamStatus @default(PENDING)
  createdAt DateTime   @default(now())
  members   TeamMember[]
  meetings  TeamMeeting[]
}

model TeamMember {
  id              String           @id @default(cuid())
  teamId          String
  team            Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name            String
  email           String
  userId          String?
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  status          TeamMemberStatus @default(PENDING)
  inviteTokenHash String?          @unique
  inviteExpiresAt DateTime?
  invitedAt       DateTime?
  createdAt       DateTime         @default(now())

  @@unique([teamId, email])
  @@index([userId])
  @@index([email])
}

model TeamMeeting {
  id             String            @id @default(cuid())
  teamId         String
  team           Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  startAt        DateTime
  endAt          DateTime
  status         TeamMeetingStatus @default(SCHEDULED)
  reminderSentAt DateTime?
  createdAt      DateTime          @default(now())

  @@index([teamId, startAt])
  @@index([startAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model VerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model DevMail {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  body      String
  link      String
  createdAt DateTime @default(now())

  @@index([userId])
}
