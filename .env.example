DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
APP_URL="http://localhost:3000"

# Local SMTP server started by `npm run dev`. Inbox: http://127.0.0.1:1080
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_IGNORE_TLS="true"
SMTP_FROM="Niko <noreply@niko.local>"
SMTP_WEB_URL="http://127.0.0.1:1080"

# To send through a real provider instead, replace the values above:
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_IGNORE_TLS="false"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="Niko <noreply@example.com>"
# SMTP_WEB_URL=""
